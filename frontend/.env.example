VITE_SPOTIFY_CLIENT_ID=your-spotify-app-client-id
VITE_BACKEND_URL=http://localhost:8000
# Auto-played for any user who connects to Spotify if no track is set in the
# room yet. Accepts one URL or a comma-separated list of URLs, in any mix of:
#   open.spotify.com/track/<id>        spotify:track:<id>
#   open.spotify.com/playlist/<id>     spotify:playlist:<id>
#   open.spotify.com/album/<id>        spotify:album:<id>
# Tracks from each source are concatenated in source order. Spotify-curated
# playlists (e.g. Daily Mix, IDs starting with 37i9dQZF1) return 403 in dev
# mode — use ones you own, with your Spotify account added to "Users and
# Access" in the developer dashboard.
VITE_DEFAULT_PLAYLIST_URL=https://open.spotify.com/playlist/your-playlist-id,https://open.spotify.com/album/your-album-id
