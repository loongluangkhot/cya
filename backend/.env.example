# Per-room cap on total voice-message bytes, in MB. FIFO eviction kicks
# in above this. Invalid values fall back to the default.
# Default: 50
CYA_AUDIO_CAP_MB=50

# Per-clip duration cap for voice messages, in seconds.
# Default: 60
CYA_VOICE_MAX_S=60

# Per-clip byte cap for voice messages, in MB. Single uploads larger than
# this are dropped before the eviction policy considers them.
# Default: 5
CYA_VOICE_MAX_MB=5

# Grace window (seconds) after the last user disconnects before a room is
# evicted. Long enough to absorb a Spotify OAuth redirect and typical
# mobile background-tab durations.
# Default: 1800 (30 minutes)
CYA_ROOM_GRACE_S=1800

# CORS allow-list — comma-separated origins. Use '*' (or leave unset) for
# dev. Tighten in prod, e.g. https://cya.app,https://staging.cya.app
# Default: *
CYA_CORS_ORIGINS=*
