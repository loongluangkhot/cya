# Per-room cap on total voice-message bytes, in MB. FIFO eviction kicks
# in above this. Invalid values fall back to the default.
# Default: 50
CYA_AUDIO_CAP_MB=50

# Per-clip duration cap for voice messages, in seconds.
# Default: 60
CYA_VOICE_MAX_S=60

# Per-clip byte cap for voice messages, in MB. Single uploads larger than
# this are dropped before the eviction policy considers them.
# Default: 5
CYA_VOICE_MAX_MB=5

# Grace window (seconds) after the last user disconnects before a room is
# evicted. Long enough to absorb a Spotify OAuth redirect and typical
# mobile background-tab durations.
# Default: 1800 (30 minutes)
CYA_ROOM_GRACE_S=1800

# CORS allow-list — comma-separated origins. Use '*' (or leave unset) for
# dev. Tighten in prod, e.g. https://cya.app,https://staging.cya.app
# Default: *
CYA_CORS_ORIGINS=*

# Suggested links shown as chips in the music sheet's paste bar — one
# slot per chip ("a song" / "a stream" / "a playlist"). Override
# any of these; empty/unset falls back to the built-in default.
CYA_YT_SONG_URL=https://youtu.be/3TnL3qVsFwg?si=FW4ihY_XCo6-1owl
CYA_YT_STREAM_URL=https://www.youtube.com/live/qGohtGC5Rtk?si=Kw9Qk-sKHr8K0fo7
CYA_YT_PLAYLIST_URL=https://www.youtube.com/playlist?list=PLd33_xdgUTjo9D5ZzOpHE11fNzavyuw45

# Web Push (VAPID). Without all three set, push fan-out is silently
# disabled — the app still works, peers just won't get OS notifications
# when their tab is backgrounded.
#
# Generate a keypair (one-time, then save somewhere safe so rotations
# are deliberate — rotating invalidates every existing browser sub):
#
#   cd backend && uv run python -c "
#   import base64
#   from py_vapid import Vapid01
#   from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat
#   v = Vapid01(); v.generate_keys()
#   print('PRIV:'); print(v.private_pem().decode())
#   raw = v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)
#   print('PUB:', base64.urlsafe_b64encode(raw).rstrip(b'=').decode())
#   "
#
# The private key is multi-line PEM — wrap in double-quotes so
# python-dotenv preserves the newlines, e.g.:
#   CYA_VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
#   ...base64 lines...
#   -----END PRIVATE KEY-----"
CYA_VAPID_PRIVATE_KEY=
CYA_VAPID_PUBLIC_KEY=
# Required `sub` claim on the JWT — Mozilla autopush rejects without it.
# A mailto: URI or HTTPS URL to a contact page both work.
CYA_VAPID_CONTACT=mailto:admin@example.com

# Marquee — comma-separated list of RSS feed URLs seeded into every
# fresh room. Users in the room can remove these like any other feed;
# the seed only runs once at room creation. Leave empty to start rooms
# with no default feeds.
CYA_MARQUEE_DEFAULT_FEED_URLS=https://www.channelnewsasia.com/api/v1/rss-outbound-feed?_format=xml&category=6311
